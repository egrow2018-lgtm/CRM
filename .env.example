# ── Base de datos (Supabase) ────────────────────────────────────────────────
# En Supabase: Project Settings → Database → Connection string.
# DATABASE_URL: "Transaction pooler" (puerto 6543), con ?pgbouncer=true al final.
DATABASE_URL="postgresql://postgres.PROYECTO:CLAVE@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL: "Session pooler" (puerto 5432). Se usa para crear las tablas (migraciones).
DIRECT_URL="postgresql://postgres.PROYECTO:CLAVE@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Para desarrollo local con PostgreSQL propio, ambas pueden ser iguales:
# DATABASE_URL="postgresql://egrow:egrow@localhost:5432/egrow_crm?schema=public"
# DIRECT_URL="postgresql://egrow:egrow@localhost:5432/egrow_crm?schema=public"

# ── Sesiones ────────────────────────────────────────────────────────────────
# Secreto para firmar las sesiones (genera uno con: openssl rand -base64 32)
AUTH_SECRET="cambia-este-valor-por-uno-largo-y-aleatorio"

# ── Usuarios iniciales ─────────────────────────────────────────────────────
# Contraseña temporal para Andrés, María Isabel y Janine (mín. 8 caracteres).
# Solo se usa al crear los usuarios por primera vez; luego cada uno la cambia en "Mi perfil".
SEED_INITIAL_PASSWORD=""
