generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  GERENTE
  COMERCIAL
  PROYECTOS
}

enum ProductType {
  PRODUCTO
  SERVICIO
}

enum LeadStatus {
  NUEVO
  EN_SEGUIMIENTO
  CALIFICADO
  DESCARTADO
}

enum ActivityType {
  NOTA
  LLAMADA
  REUNION
  EMAIL
  TAREA
  CAMBIO_ETAPA
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(COMERCIAL)
  active       Boolean  @default(true)
  /// Recibe el resumen diario por correo
  digestEnabled Boolean @default(true)
  /// Si es true, se usan `permissions` en lugar de los permisos por defecto del perfil
  customPermissions Boolean  @default(false)
  permissions       String[] @default([])
  /// Otros correos que reciben copia de sus reuniones (ej. el correo personal)
  extraEmails       String[] @default([])
  /// Dirección desde la que salen sus correos a clientes (debe ser del dominio verificado en Resend)
  senderEmail       String?
  /// Firma que se agrega al final de sus correos
  signature         String?
  /// Imagen de firma (como la de Outlook) y su ancho en px (null = automático)
  signatureImageId    String?
  signatureImage      EmailImage? @relation("SignatureImage", fields: [signatureImageId], references: [id], onDelete: SetNull)
  signatureImageWidth Int?
  /// Avisarle por correo cuando abran sus correos o documentos
  trackingAlerts    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  companies          Company[]
  contacts           Contact[]
  deals              Deal[]
  activitiesCreated  Activity[] @relation("ActivityAuthor")
  activitiesAssigned Activity[] @relation("ActivityAssignee")
  formsAssigned      Form[]     @relation("FormAssignee")
  quotes             Quote[]
  documents          Document[]
  documentLinks      DocumentLink[]
  emailTemplates     EmailTemplate[]
  emailsSent         EmailMessage[]
  emailImages        EmailImage[]
}

/// Línea de negocio: e-learning, Rutalink, Ludus, Humand, nuevas representaciones…
model BusinessLine {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  color       String   @default("#1c315e")
  active      Boolean  @default(true)
  /// Campos adicionales que se activan en los negocios de esta línea (ver src/lib/custom-fields.ts)
  customFields Json    @default("[]")
  /// Marca propia para las cotizaciones de esta línea (ej. Rutalink). Si no hay logo, se usa la de e-grow.
  brandName    String?
  brandLogo    String? /// data URL PNG o JPEG
  brandPrimary String? /// color principal (títulos, encabezado de la tabla)
  brandAccent  String? /// color de acento (barra y total)
  brandWebsite String?
  brandHeaderBg String? /// fondo del encabezado del PDF (para logos claros); vacío = blanco
  createdAt   DateTime @default(now())

  products Product[]
  deals    Deal[]
  forms    Form[]
  emailTemplates EmailTemplate[]
}

model Product {
  id             String      @id @default(cuid())
  name           String
  description    String?
  sku            String?
  type           ProductType @default(SERVICIO)
  unitPrice      Decimal     @default(0) @db.Decimal(14, 2)
  /// Servicio recurrente (licencias, monitoreo…): se renueva cada N meses
  renewalMonths  Int?
  active         Boolean     @default(true)
  businessLineId String
  businessLine   BusinessLine @relation(fields: [businessLineId], references: [id])
  createdAt      DateTime    @default(now())

  dealItems DealItem[]

  @@index([businessLineId])
}

/// Etapas del pipeline (configurables por el administrador)
model PipelineStage {
  id          String  @id @default(cuid())
  name        String
  order       Int
  probability Int     @default(0) // 0-100, usado para la cantidad ponderada
  isWon       Boolean @default(false)
  isLost      Boolean @default(false)

  deals Deal[]
}

model Company {
  id        String   @id @default(cuid())
  name      String
  taxId     String?  // RUC / NIT
  industry  String?
  website   String?
  phone     String?
  address   String?
  city      String?
  country   String?
  notes     String?
  ownerId   String?
  owner     User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  lastActivityAt DateTime? // última actividad en la empresa, sus contactos o sus negocios
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts   Contact[]
  deals      Deal[]
  activities Activity[]
  emails     EmailMessage[]

  @@index([name])
  @@index([ownerId])
  @@index([createdAt])
  @@index([lastActivityAt])
}

model Contact {
  id        String   @id @default(cuid())
  firstName String
  lastName  String?
  email     String?
  phone     String?
  jobTitle  String?
  source     String?
  notes      String?
  leadStatus     LeadStatus?
  lastActivityAt DateTime?
  companyId      String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  ownerId   String?
  owner     User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deals       Deal[]
  activities  Activity[]
  submissions FormSubmission[]
  emails        EmailMessage[]
  documentLinks DocumentLink[]

  @@index([companyId])
  @@index([leadStatus])
  @@index([email])
}

model Deal {
  id             String        @id @default(cuid())
  name           String
  amount         Decimal       @default(0) @db.Decimal(14, 2)
  currency       String        @default("USD")
  description    String?
  closeDate      DateTime?
  lostReason     String?
  stageId        String
  stage          PipelineStage @relation(fields: [stageId], references: [id])
  businessLineId String?
  businessLine   BusinessLine? @relation(fields: [businessLineId], references: [id], onDelete: SetNull)
  companyId      String?
  company        Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId      String?
  contact        Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  ownerId        String?
  owner          User?         @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  /// Valores de los campos adicionales de la línea de negocio
  customData     Json          @default("{}")
  /// Renovación (ingresos recurrentes): fecha y negocio del que proviene
  renewalDate    DateTime?
  renewalOfId    String?
  renewalOf      Deal?         @relation("Renewals", fields: [renewalOfId], references: [id], onDelete: SetNull)
  renewals       Deal[]        @relation("Renewals")
  stageChangedAt DateTime      @default(now())
  lastActivityAt DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  items      DealItem[]
  activities Activity[]
  quotes     Quote[]
  emails     EmailMessage[]

  @@index([stageId])
  @@index([renewalDate])
  @@index([ownerId])
  @@index([businessLineId])
}

/// Productos / servicios cotizados dentro de un negocio
model DealItem {
  id          String   @id @default(cuid())
  dealId      String
  deal        Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  description String
  quantity    Decimal  @default(1) @db.Decimal(12, 2)
  unitPrice   Decimal  @default(0) @db.Decimal(14, 2)
  discount    Decimal  @default(0) @db.Decimal(5, 2) // porcentaje

  @@index([dealId])
}

/// Notas, llamadas, reuniones, correos, tareas y cambios de etapa
model Activity {
  id          String       @id @default(cuid())
  type        ActivityType
  subject     String
  body        String?
  dueDate     DateTime?
  /// Reuniones: fecha y hora exactas (UTC), duración y enlaces (Zoom u otro)
  startAt         DateTime?
  durationMinutes Int?
  meetingUrl      String?
  hostUrl         String?
  meetingPassword String?
  zoomMeetingId   String?
  /// Lugar de la reunión presencial (dirección, oficina del cliente…)
  location        String?
  /// Correos de los invitados a la reunión
  guests          String[]  @default([])
  /// Cuándo se envió la invitación por correo (null = no se envió)
  invitedAt       DateTime?
  /// Correo enviado desde el CRM (con seguimiento de aperturas)
  emailId         String?   @unique
  email           EmailMessage? @relation(fields: [emailId], references: [id], onDelete: SetNull)
  completed   Boolean      @default(false)
  completedAt DateTime?
  dealId      String?
  deal        Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  contactId   String?
  contact     Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  companyId   String?
  company     Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  authorId    String?
  author      User?        @relation("ActivityAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  assigneeId  String?
  assignee    User?        @relation("ActivityAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())

  @@index([dealId])
  @@index([contactId])
  @@index([companyId])
  @@index([assigneeId, completed])
  @@index([startAt])
}

/// Formulario público (para redes, publicaciones o sitio web) que alimenta la base de contactos
model Form {
  id             String        @id @default(cuid())
  name           String
  slug           String        @unique
  title          String
  description    String?
  /// Campos del formulario (ver src/lib/forms-builder.ts)
  fields         Json          @default("[]")
  submitLabel    String        @default("Enviar")
  successMessage String        @default("¡Gracias! Te contactaremos pronto.")
  active         Boolean       @default(true)
  businessLineId String?
  businessLine   BusinessLine? @relation(fields: [businessLineId], references: [id], onDelete: SetNull)
  /// Usuario que recibe automáticamente los leads (vacío = bandeja de leads para que alguien los tome)
  assigneeId     String?
  assignee       User?         @relation("FormAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  /// Logo o imagen de cabecera (data URL, máx. ~300 KB)
  logo           String?
  /// Casilla obligatoria de autorización de tratamiento de datos personales
  consentEnabled Boolean       @default(true)
  consentText    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt

  submissions FormSubmission[]
  views       FormView[]
}

/// Una visita a la página pública del formulario (para la tasa de conversión)
model FormView {
  id        String   @id @default(cuid())
  formId    String
  form      Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([formId, createdAt])
}

model FormSubmission {
  id        String   @id @default(cuid())
  formId    String
  form      Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  data      Json
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  /// Momento en que la persona aceptó el tratamiento de sus datos (null si el formulario no lo pide)
  consentAt DateTime?
  createdAt DateTime @default(now())

  @@index([formId, createdAt])
}

/// Cotización generada desde un negocio (los datos quedan congelados al generarla)
model Quote {
  id          String   @id @default(cuid())
  year        Int
  number      Int
  dealId      String
  deal        Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  /// Token aleatorio para el enlace público del PDF (para WhatsApp o correo)
  publicToken String   @unique
  validUntil  DateTime
  /// Cliente, ítems, totales y condiciones tal como se cotizaron
  snapshot    Json
  total       Decimal  @db.Decimal(14, 2)
  sentAt      DateTime?
  status      QuoteStatus @default(EMITIDA)
  statusChangedAt DateTime?
  /// Clave del formulario que la creó: evita duplicados si se pulsa dos veces «Generar»
  requestKey  String?  @unique
  createdAt   DateTime @default(now())

  links  DocumentLink[]
  emails EmailMessage[]

  @@unique([year, number])
  @@index([dealId])
}

/// Estado de una cotización frente al cliente
enum QuoteStatus {
  EMITIDA
  EN_REVISION
  APROBADA
  NO_APROBADA
}

/// Ajustes generales (datos de la empresa para cotizaciones, etc.)
model AppSetting {
  key   String @id
  value Json
}

/// Carpeta de la biblioteca de documentos
model DocumentFolder {
  id        String     @id @default(cuid())
  name      String     @unique
  createdAt DateTime   @default(now())
  documents Document[]
}

/// Documento de la biblioteca (el archivo se guarda en Supabase Storage)
model Document {
  id              String   @id @default(cuid())
  name            String
  description     String?
  fileName        String
  mimeType        String
  size            Int
  storagePath     String   @unique
  pageCount       Int?
  /// Miniatura de la primera página (data URL JPEG)
  thumbnail       String?
  allowDownload   Boolean  @default(true)
  /// Pide aceptar el aviso de uso de datos antes de ver el documento
  consentRequired Boolean  @default(false)
  folderId        String?
  folder          DocumentFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  ownerId         String?
  owner           User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  links DocumentLink[]

  @@index([folderId])
}

/// Enlace rastreado a un documento o a una cotización (uno por destinatario)
model DocumentLink {
  id          String    @id @default(cuid())
  token       String    @unique
  documentId  String?
  document    Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  quoteId     String?
  quote       Quote?    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  contactId   String?
  contact     Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  emailId     String?
  email       EmailMessage? @relation(fields: [emailId], references: [id], onDelete: SetNull)
  /// Para enlaces sin contacto (ej. "Grupo de WhatsApp")
  label       String?
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  lastNotifiedAt DateTime?
  createdAt   DateTime  @default(now())

  views DocumentView[]

  @@index([documentId])
  @@index([quoteId])
  @@index([contactId])
}

/// Una visita a un documento: tiempo total y por página
model DocumentView {
  id          String   @id @default(cuid())
  linkId      String
  link        DocumentLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  startedAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  durationSec Int      @default(0)
  /// { "1": segundos, "2": segundos, … }
  pageTimes   Json     @default("{}")
  downloaded  Boolean  @default(false)
  /// Correo que escribió el visitante (enlaces sin contacto con aviso de datos)
  viewerEmail String?
  consentAt   DateTime?
  userAgent   String?

  @@index([linkId, startedAt])
}

/// Plantilla de correo. El cuerpo admite **negrita**, {{variables}} y [[doc:ID]] para documentos.
model EmailTemplate {
  id             String   @id @default(cuid())
  name           String
  subject        String
  body           String
  businessLineId String?
  businessLine   BusinessLine? @relation(fields: [businessLineId], references: [id], onDelete: SetNull)
  createdById    String?
  createdBy      User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  emails EmailMessage[]
}

/// Correo enviado desde el CRM, con seguimiento de aperturas y clics
model EmailMessage {
  id          String   @id @default(cuid())
  /// Token del píxel de apertura y de los enlaces rastreados
  token       String   @unique
  fromUserId  String?
  fromUser    User?    @relation(fields: [fromUserId], references: [id], onDelete: SetNull)
  fromEmail   String
  to          String[]
  cc          String[] @default([])
  subject     String
  /// Texto tal como lo escribió el vendedor y HTML enviado (sin píxel)
  body        String
  html        String
  /// Destinos de los enlaces rastreados, por posición
  links       String[] @default([])
  contactId   String?
  contact     Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  dealId      String?
  deal        Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  quoteId     String?
  quote       Quote?   @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  templateId  String?
  template    EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  sentAt      DateTime @default(now())
  openCount   Int      @default(0)
  firstOpenedAt DateTime?
  lastOpenedAt  DateTime?
  clickCount  Int      @default(0)
  lastClickedAt DateTime?
  lastNotifiedAt DateTime?
  /// Id del correo en Resend y último estado de entrega que informó (delivered, bounced, complained…)
  providerId     String?
  deliveryStatus String?
  deliveryCheckedAt DateTime?

  events   EmailEvent[]
  docLinks DocumentLink[]
  activity Activity?

  @@index([fromUserId, sentAt])
  @@index([contactId])
  @@index([dealId])
  @@index([sentAt])
}

/// Apertura o clic de un correo enviado desde el CRM
model EmailEvent {
  id        String   @id @default(cuid())
  emailId   String
  email     EmailMessage @relation(fields: [emailId], references: [id], onDelete: Cascade)
  /// "open" o "click"
  type      String
  url       String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([emailId, createdAt])
}

/// Imagen para usar en correos y plantillas (se sirve en /api/img/[id] para que la vean los clientes)
model EmailImage {
  id          String   @id @default(cuid())
  name        String
  mimeType    String
  data        Bytes
  width       Int?
  height      Int?
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  signatureOf User[]   @relation("SignatureImage")
}
